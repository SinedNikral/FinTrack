  <property name="styleSheet">
   <string notr="true">QWidget#sidebar {
background-color: #263B69;
}

QWidget#sidebar QPushButton {
background: #3B5678;
color: white;
border: none;
border-radius: 16px;
padding: 12px 15px;
text-align: left;
font-size: 14px;
}

QWidget#sidebar QPushButton:hover {
background-color: #4B6688;
}

QWidget#contentArea {
background-color: #F3F6FA;
}

QFrame#cardBalance {
background-color: white;
border: 1px solid #E2E8F0;
border-radius: 10px;
}

QFrame#cardIncome {
background-color: white;
border: 1px solid #E2E8F0;
border-radius: 10px;
}

QFrame#cardExpense {
background-color: white;
border: 1px solid #E2E8F0;
border-radius: 10px;
}

QPushButton#btnAddTransaction {
background-color: #2563EB;
color: white;
border: none;
border-radius: 6px;
padding: 10px 16px;
font-size: 14px;
font-weight: bold;
}

QPushButton#btnAddTransaction:hover {
background-color: #1D4ED8;
}

QPushButton#btnResetFilters {
background-color: #E2E8F0;
color: #263B59;
border: none;
border-radius: 6px;
padding: 8px 12px;
}

QPushButton#btnResetFilters:hover {
background-color: #CBD5E1;
}

QTableView#tableTransactions,
QTableView#tableCategories,
QTableView#tableBudgets,
QTableView#tableRecentTransactions,
QTableView#tableReportsHistory {

    background-color: white;
    alternate-background-color: #F8FAFC;
    color: #263B59;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #263B59;

}

QTableView#tableTransactions::item,
QTableView#tableCategories::item,
QTableView#tableBudgets::item,
QTableView#tableRecentTransactions::item,
QTableView#tableReportsHistory::item {

    padding: 8px;

}

QPushButton#btnAddNewTransaction {
background-color: #2563E8;
color: white;
border: none;
border-radius: 6px;
padding: 8px 14px;
font-weight: bold;
}

QPushButton#btnAddNewTransaction:hover {
background-color: #1D4ED8;
}

QPushButton#btnEditTransaction {
background-color: #E2E8F0;
color: #263B59;
border: none;
border-radius: 6px;
padding: 8px 14px;
}

QPushButton#btnEditTransaction:hover {
background-color: #CBD5E1;
}

QPushButton#btnDeleteTransaction {
background-color: #FEE2E2;
color: #DC2626;
border: none;
border-radius: 6px;
padding: 8px 14px;
}

QPushButton#btnDeleteTransaction:hover {
background-color: #FECACA;
}

QPushButton#btnAddCategory,
QPushButton#btnAddBudget {
background-color: #2563E8;
color: white;
border: none;
border-radius: 6px;
padding: 8px 14px;
font-weight: bold;
}

QPushButton#btnAddCategory:hover,
QPushButton#btnAddBudget:hover {
background-color: #1D4ED8;
}

QPushButton#btnEditCategory,
QPushButton#btnEditBudget {
background-color: #E2E8F0;
color: #263B59;
border: none;
border-radius: 6px;
padding: 8px 14px;
}

QPushButton#btnEditCategory:hover,
QPushButton#btnEditBudget:hover {
background-color: #CBD5E1;
}

QPushButton#btnDeleteCategory,
QPushButton#btnDeleteBudget,
QPushButton#btnDeleteReport {
background-color: #FEE2E2;
color: #DC2626;
border: none;
border-radius: 6px;
padding: 8px 14px;
}

QPushButton#btnDeleteCategory:hover,
QPushButton#btnDeleteBudget:hover,
QPushButton#btnDeleteReport:hover {
background-color: #FECACA;
}

QFrame#cardBudgetLimit,
QFrame#cardAnalyticsIncome,
QFrame#cardBudgetSpent,
QFrame#cardAnalyticsExpense,
QFrame#cardBudgetRemaining,
QFrame#cardAnalyticsBalance,
QFrame#analyticsChartContainer,
QFrame#analyticsCategoriesContainer {
background-color: white;
border: 1px solid #E2E8F0;
border-radius: 10px;
}

QLabel#lblBudgetLimitTitle,
QLabel#lblBudgetSpentTitle,
QLabel#lblBudgetRemainingTitle {
color: #64748B;
font-size: 12px;
}

QLabel#lblBudgetLimitValue {
color: #263B59;
font-size: 24px;
font-weight: bold;
}

QLabel#lblBudgetSpentValue {
color: #DC2626;
font-size: 24px;
font-weight: bold;
}

QLabel#lblBudgetRemainingValue {
color: #16A34A;
font-size: 24px;
font-weight: bold;
}

QPushButton#btnGenerateReport {
background-color: #2563EB;
color: white;
border: none;
border-radius: 6px;
padding: 8px 14px;
font-weight: bold;
}

QPushButton#btnGenerateReport:hover {
background-color: #1D4ED8;
}</string>
